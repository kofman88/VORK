# Telegram Bot
BOT_TOKEN=your_bot_token_here
WEBAPP_URL=https://yourdomain.com

# Database
POSTGRES_USER=vork
POSTGRES_PASSWORD=vorkpassword
POSTGRES_DB=vork_db
DATABASE_URL=postgresql+asyncpg://vork:vorkpassword@postgres:5432/vork_db

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET=your-very-long-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Payments
TON_WALLET=your-ton-wallet-address
PAYMENT_PROVIDER_TOKEN=your-telegram-payment-provider-token

# Storage
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE=10485760

# Platform Settings
PLATFORM_FEE_PERCENT=10
MIN_WITHDRAWAL=1000

# Environment
DEBUG=false
ALLOWED_ORIGINS=https://yourdomain.com,https://web.telegram.org
